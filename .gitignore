# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secretos, nunca se commitean
.env
.env*.local
.env.development
.env.production

# base de datos: se versiona local.db (catálogo de solo lectura que se
# empaqueta en el deploy). Los ficheros de journal/WAL sí se ignoran.
/local.db-*
*.sqlite
*.sqlite3

# drizzle
/drizzle/meta/_journal.json.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
