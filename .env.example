# Copia este archivo a .env.local y rellena con credenciales reales de Turso.
# .env.local NUNCA se commitea (ver .gitignore).
#
# Obtener credenciales:
#   turso db create wiki-camp
#   turso db show wiki-camp --url     -> TURSO_DATABASE_URL   (libsql://...)
#   turso db tokens create wiki-camp  -> TURSO_AUTH_TOKEN
#
# Si TURSO_DATABASE_URL queda vacío o con el placeholder, el proyecto
# cae automáticamente a una base SQLite local en ./local.db para desarrollo.
TURSO_DATABASE_URL=<TU_TURSO_DATABASE_URL>
TURSO_AUTH_TOKEN=<TU_TURSO_AUTH_TOKEN>
